# Copiá este archivo como .env y completá tus valores. El .env no se sube a git.

# OBLIGATORIO: clave de YouTube Data API v3
YOUTUBE_API_KEY=pon_tu_api_key_aqui
# OPCIONAL: segunda clave (de otro proyecto de Google Cloud) para duplicar la cuota diaria
API_KEY_2=

# OPCIONAL: cuota por clave (YouTube da 10.000 unidades por día y por proyecto)
CUOTA_DIARIA_LIMITE=10000
CUOTA_BUFFER_SEGURIDAD=500

# OPCIONAL: filtros mínimos
MIN_SUSCRIPTORES=500
MIN_CERTEZA_ARGENTINA=70
